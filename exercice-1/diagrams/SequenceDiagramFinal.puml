@startuml
!pragma teoz true
box "bash process"
participant bash

box "multitaskingAccumulatorPosix process (child process)" #lightblue
participant "main" as main
participant "producers[i]:pthread_t" as producer
participant "consumer:pthread_t" as consumer
participant "displayThread:pthread_t" as display
participant "writeIdxMutex:pthread_mutex_t" as writeIdxMutex
participant "countMutex:pthread_mutex_t" as countMutex
participant "semFree:sem_t" as semFree
participant "semFull:sem_t" as semFull
participant "sumMutex:pthread_mutex_t" as sumMutex
end box
end box

activate bash
bash -> main --++ : "./multitaskingAccumulatorPosix"

== Initialisation ==

group acquisitionManagerInit()
  main -> semFree : sem_unlink / sem_open(BUFFER_SIZE)
  activate semFree #gold
  return
  note over semFree : 8
  main -> semFull : sem_unlink / sem_open(0)
  activate semFull #gold
  return
  note over semFull : 0
  note over writeIdxMutex : 1
  note over countMutex : 1
  loop PRODUCER_COUNT (i = 0..3)
    main -> producer : pthread_create(produce, i)
    activate producer #FFBBBB
    producer --> main
  end
end

group messageAdderInit()
  note over sumMutex : 1
  main -> consumer : pthread_create(sum)
  activate consumer #FFBBBB
  consumer --> main
end

group displayManagerInit()
  main -> display : pthread_create(display)
  activate display #FFBBBB
  display --> main
end

main -> display : pthread_join (displayManagerJoin)
deactivate main

== Consommateur en attente d'un message ==

consumer -> consumer : sleep(ADDER_SLEEP_TIME)
consumer -> semFull : getMessage() : sem_wait(semFull)
note over semFull : 0 : consumer bloqué

== Production (4 producteurs en parallèle) ==

producer -> producer : sleep(PRODUCER_SLEEP_TIME + rand()%5)
producer -> producer : getInput(i, &local)
producer -> producer : messageCheck(&local)

alt checksum KO
  producer -> producer : log erreur, message supprimé (Exigence 3)
else checksum OK
  producer -> semFree : sem_wait
  activate semFree #gold
  return
  note over semFree : 7

  producer -> writeIdxMutex : pthread_mutex_lock
  activate writeIdxMutex #plum
  return
  note over writeIdxMutex : 0
  producer -> producer : idx = writeIdx\nwriteIdx = (writeIdx + 1) % BUFFER_SIZE\nbuffer[idx] = local
  producer -> writeIdxMutex : pthread_mutex_unlock
  activate writeIdxMutex #plum
  return
  note over writeIdxMutex : 1

  group incrementProducedCount()
    producer -> countMutex : pthread_mutex_lock
    activate countMutex #plum
    return
    note over countMutex : 0
    producer -> producer : produceCount++
    producer -> countMutex : pthread_mutex_unlock
    activate countMutex #plum
    return
    note over countMutex : 1
  end

  producer -> semFull : sem_post
  note over semFull : 1
  semFull --> consumer : déblocage
  note over semFull : 0
end

== Consommation (somme) ==

consumer -> consumer : msg = buffer[readIdx]\nreadIdx = (readIdx + 1) % BUFFER_SIZE
consumer -> semFree : sem_post
activate semFree #gold
return
note over semFree : 8

consumer -> sumMutex : pthread_mutex_lock
activate sumMutex #plum
return
note over sumMutex : 0
consumer -> consumer : messageAdd(&out, &msg)\nconsumeCount++ (incrementConsumeCount)
consumer -> sumMutex : pthread_mutex_unlock
activate sumMutex #plum
return
note over sumMutex : 1

== Affichage (asynchrone, Exigence 5) ==

display -> display : sleep(DISPLAY_SLEEP_TIME)

loop tant que c1 != c2 (une somme a eu lieu entre les deux lectures)
  group c1 = getConsumedCount()
    display -> sumMutex : pthread_mutex_lock
    activate sumMutex #plum
    return
    display -> display : copie de consumeCount
    display -> sumMutex : pthread_mutex_unlock
    activate sumMutex #plum
    return
  end

  group s = getCurrentSum()
    display -> sumMutex : pthread_mutex_lock
    activate sumMutex #plum
    return
    note over sumMutex : 0
    display -> display : copie de out
    display -> sumMutex : pthread_mutex_unlock
    activate sumMutex #plum
    return
    note over sumMutex : 1
  end

  group c2 = getConsumedCount()
    display -> sumMutex : pthread_mutex_lock
    activate sumMutex #plum
    return
    display -> display : copie de consumeCount
    display -> sumMutex : pthread_mutex_unlock
    activate sumMutex #plum
    return
  end
end

group getProducedCount()
  display -> countMutex : pthread_mutex_lock
  activate countMutex #plum
  return
  display -> display : copie de produceCount
  display -> countMutex : pthread_mutex_unlock
  activate countMutex #plum
  return
end

display -> display : messageDisplay(&s)\nprint(produced, c1)

== Terminaison ==

display -> display : pthread_exit
display --> main --++
deactivate display
main -> consumer : pthread_join (messageAdderJoin)
deactivate main
consumer -> consumer : pthread_exit
consumer --> main --++
deactivate consumer
loop PRODUCER_COUNT
  main -> producer : pthread_join (acquisitionManagerJoin)
  producer -> producer : pthread_exit
  producer --> main
end
deactivate producer

main -> semFree : sem_close / sem_unlink
activate semFree #gold
return
main -> semFull : sem_close / sem_unlink
activate semFull #gold
return
main -> writeIdxMutex : pthread_mutex_destroy
main -> countMutex : pthread_mutex_destroy
main -> sumMutex : pthread_mutex_destroy

main -> bash --++ : return ERROR_SUCCESS

@enduml
